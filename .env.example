# ========================================
# FinStocks — Environment Variables
# ========================================
# Salin file ini ke .env dan sesuaikan nilainya

# === BACKEND ===
# Server
PORT=5000
NODE_ENV=development

# Database (MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/finstocks_db"

# JWT
JWT_SECRET=finstocks_jwt_secret_key_ganti_ini_di_production
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:5173

# Google Sign-In
GOOGLE_CLIENT_ID=

# Email (SMTP Gmail + App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# === FRONTEND ===
VITE_API_BASE_URL=http://localhost:5000/api
VITE_GOOGLE_CLIENT_ID=
