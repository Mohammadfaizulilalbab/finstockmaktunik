# ============================================
# FinStocks Backend — Environment Variables
# ============================================
# Salin file ini menjadi .env dan isi nilainya

# Server
PORT=5000
NODE_ENV=development

# Database (MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/finstocks_db"

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=8h

# Frontend URL (untuk CORS)
FRONTEND_URL=http://localhost:5173

# Google Sign-In (Google Cloud Console → APIs & Services → Credentials → OAuth Client ID tipe "Web application")
# Isi "Authorized JavaScript origins" dengan URL frontend, mis. http://localhost:5173
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Email (SMTP) — untuk verifikasi pendaftaran, reset password & notifikasi
# Gmail: aktifkan 2-Step Verification lalu buat App Password di https://myaccount.google.com/apppasswords
# Jika dikosongkan saat development, isi email ditampilkan di console backend
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FinStocks <emailanda@gmail.com>"
