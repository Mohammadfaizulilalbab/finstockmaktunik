# ============================================
# FinStocks Frontend — Environment Variables
# ============================================
# Salin file ini menjadi .env dan isi nilainya

# Backend API URL
VITE_API_BASE_URL=http://localhost:5000/api

# Google Sign-In — harus sama dengan GOOGLE_CLIENT_ID di backend
# Kosongkan untuk menyembunyikan tombol "Masuk dengan Google"
VITE_GOOGLE_CLIENT_ID=
